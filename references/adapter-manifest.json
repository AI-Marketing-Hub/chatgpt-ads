      "status": "unavailable",
      "reason": "No authenticated account connector implemented or tested."
    },
    {
      "id": "codex-browser",
      "status": "procedural",
      "entrypoint": "runtime/codex.md",
      "account_verified": false
    },
    {
      "id": "claude-browser",
      "status": "procedural",
      "entrypoint": "runtime/claude.md",
      "account_verified": false
    }
  ]
