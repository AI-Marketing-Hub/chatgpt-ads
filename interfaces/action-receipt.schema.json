{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","required":["schema_version","record_type","id","created_at","operation_id","action_plan_id","action_sha256","observed_account_id","target","observed_settings","outcome","detail","observed_at","simulated","evidence_scope","evidence_refs"],"properties":{"schema_version":{"const":"v0.2"},"record_type":{"const":"action_receipt"},"id":{"type":"string","minLength":1},"created_at":{"type":"string","pattern":"Z$"},"operation_id":{"type":"string","minLength":1},"action_plan_id":{"type":"string","minLength":1},"action_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"observed_account_id":{"type":"string","minLength":1},"target":{"type":"object","required":["resource_type","resource_id"]},"observed_settings":{"type":"object"},"outcome":{"enum":["succeeded","rejected","uncertain","reconciled"]},"detail":{"type":"string","minLength":1},"observed_at":{"type":"string","pattern":"Z$"},"simulated":{"type":"boolean"},"evidence_scope":{"enum":["simulated","live_observed","mixed"]},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"object","required":["sha256"],"properties":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}}}
